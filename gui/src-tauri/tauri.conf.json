{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiCoworker",
  "version": "0.5.3",
  "identifier": "com.coworker.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "公司企业 AI 助手",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:17331 http://localhost:17331; img-src 'self' http://127.0.0.1:17331 data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend": "gui/backend",
      "../../extensions": "extensions",
      "../../agent": "agent",
      "../../config": "config",
      "../../skills": "skills",
      "../../bin": "bin",
      "../../scripts/update": "scripts/update",
      "../../package.json": "package.json",
      "../../LICENSE": "LICENSE",
      "../../README.md": "README.md",
      "../../node_modules/typebox": "node_modules/typebox",
      "../../node_modules/jiti": "node_modules/jiti",
      "resources/pi": "pi",
      "resources/runtime": "runtime"
    }
  }
}

{
  "rolePolicies": {
    "employee": {
      "clusters": ["onboarding", "permissions", "knowledge", "personal"]
    },
    "admin": {
      "clusters": ["onboarding", "permissions", "knowledge", "governance", "personal"]
    },
    "permissions-manager": {
      "clusters": ["onboarding", "permissions", "knowledge", "personal"]
    }
  },
  "writeGuards": {
    "permissions": {
      "apply": "confirm",
      "selfService": "confirm"
    }
  },
  "defaultRole": "employee",
  "rules": {
    "minimalScopeLogin": true,
    "requireUserConfirmOnWrite": true,
    "redactSecrets": true,
    "blockDestructiveShell": true,
    "requireRegisteredSource": true,
    "authLoginRequiresNoWait": true,
    "neverSwitchIdentityOnError": true
  }
}

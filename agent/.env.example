# ===== Bot Agent 守护程序配置 =====
# 复制为 .env 或注入环境变量

# 运行模式：local（默认，个人本机 Bot）| server（公司共享服务器 Bot）
RUN_MODE=local

# 模型接入（pi 使用）。留空 LLM_PROVIDER：已配置 magene 网关凭证则自动用 magene，否则 google
LLM_PROVIDER=
LLM_MODEL=
THINKING_LEVEL=medium

# pi / 扩展路径
PI_BIN=pi
# 默认取仓库 extensions/index.ts，一般无需改
# COWORKER_EXT=

# ---- 工具白名单 ----
# server 模式：默认只读子集，禁止本地工具与授权写工具（勿改）
# local 模式：默认全部 coworker 工具；LOCAL_ENABLE_SHELL=1 额外开启本地工具（bash/read/write）
NO_BUILTIN_TOOLS=1
LOCAL_ENABLE_SHELL=0
# 自定义白名单（逗号分隔）会覆盖默认
# TOOL_ALLOWLIST=

# agent 池
MAX_AGENTS=20
AGENT_IDLE_TTL_MS=600000
SESSION_DIR=~/.coworker/local-sessions   # server 模式默认 ~/.coworker/server-sessions

# 超时（写操作会等用户在飞书点确认卡片，别把单轮超时设得比确认卡还短）
ASK_TIMEOUT_MS=300000      # 单轮问答超时（默认 5 分钟）
CONFIRM_TTL_MS=240000      # 确认卡有效期（默认 4 分钟；到期按取消处理）

# 事件总线排障开关（默认无需设置）
# COWORKER_STATE_DIR=~/.coworker        # 状态/控制文件目录（bus-state.json / bus-control.json）
# COWORKER_BUS_KEEP_LOCAL=1             # 启动时不要清理本机残留总线
# COWORKER_BUS_YIELD_SIGNAL=0           # 禁发跨机让位信令（server/测试环境防误踢）

# 限流
RATE_WINDOW_MS=60000
RATE_MAX=60

# 审计
AUDIT_FILE=~/.coworker/audit.jsonl

# 轻心跳（可选，默认关）：仅上报 {openId,status,ts}，不携带对话内容；IT 用来看谁掉线
# HEARTBEAT_URL=https://<your-heartbeat-endpoint>
# HEARTBEAT_INTERVAL_MS=60000

# 自更新检查（可选，默认关）：更新源返回 {version,url,notes}；发现新版本时日志+审计+通知绑定用户
# UPDATE_URL=https://<your-update-source>/version.json
# UPDATE_CHECK_INTERVAL_MS=21600000

# 飞书事件（个人 Bot / 公司 Bot 均适用）
# LARK_EVENT_MESSAGE=im.message.receive_v1
# LARK_EVENT_CARD=card.action.trigger
